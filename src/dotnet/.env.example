# Fill in your parameters for Azure authentication and Foundry project details
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-app-id>
AZURE_CLIENT_SECRET=<your-client-secret>
FOUNDRY_RESOURCE_ID=/subscriptions/<your-subscription-id>/resourceGroups/<your-resourcegroup>/providers/Microsoft.CognitiveServices/accounts/<your-foundry-project>/projects/<your-foundry-project>
FOUNDRY_LOOKBACK_DAYS=30
# Price for GPT-5.4
FOUNDRY_INPUT_PRICE_PER_1K=0.0025
FOUNDRY_OUTPUT_PRICE_PER_1K=0.015
# Price for GPT-5.4-mini
# FOUNDRY_INPUT_PRICE_PER_1K=0.00075
# FOUNDRY_OUTPUT_PRICE_PER_1K=0.0045
# etc...
